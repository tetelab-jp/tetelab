{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tete-aout-cron-trigger",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  // 1分間隔で本体アプリの /api/cron/run-style-posts を叩く。
  // style_post_schedules.run_times は "HH:MM" 単位のため1分間隔が必要。
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    // 要設定: 本体アプリ(Cloudflare Pages)のデプロイ後URL + /api/cron/run-style-posts
    "TARGET_URL": "https://REPLACE-ME.pages.dev/api/cron/run-style-posts"
  }
  // CRON_SECRET は平文で残さないよう vars ではなく secret として設定すること:
  //   npx wrangler secret put CRON_SECRET
  // (本体アプリ側の CRON_SECRET と同じ値にする)
}
